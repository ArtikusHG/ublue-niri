#!/usr/bin/env bash
# temporarily switch keyboard layout to eng when CTRL or alt are held. fixes an annoying issue with using colemak + russian stock layout, where depending on the layout, i have to press different physical key on the keyboard to get to the same hotkeys.

layout=0

sudo /home/artikus/.local/bin/keycode_listener | while read -r line; do
    if echo "$line" | grep -qE "CTRL|META"; then
        if echo "$line" | grep -q "pressed"; then
            layout=$(niri msg keyboard-layouts | grep \* | awk '{print $2}')
			niri msg action switch-layout 0
        elif echo "$line" | grep -q "released"; then
            niri msg action switch-layout $layout
        fi
    fi
done
